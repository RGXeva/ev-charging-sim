# SPDX-License-Identifier: MIT
# LeakSanitizer suppressions: allocations made inside Open MPI 4.1.5 itself that the
# library does not release in MPI_Finalize (verified: no frame in our src/*.c).
leak:libmpi.so
leak:libopen-pal.so
leak:libopen-rte.so
leak:libpmix.so
# hwloc (hardware topology library used by Open MPI) keeps its bitmaps until exit
leak:hwloc_bitmap_alloc
