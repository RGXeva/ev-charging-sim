#!/bin/bash
# SPDX-License-Identifier: MIT
# Correctness job: build check + the full test suite on the cluster (srun launcher).
# submit:  sbatch jobs/test.job
#SBATCH --job-name=wsn_test
#SBATCH --partition=defq
#SBATCH --time=00:10:00
#SBATCH --mem=16G
#SBATCH --nodes=2
#SBATCH --ntasks=32
#SBATCH --ntasks-per-node=16
#SBATCH --cpus-per-task=1
#SBATCH --output=results/caas/logs/%x_%j.out
cd "$SLURM_SUBMIT_DIR"
module load openmpi/4.1.5-gcc-11.2.0-ux65npg
echo "ENV job=$SLURM_JOB_ID nodes=$SLURM_JOB_NODELIST host=$(hostname -s) $(date '+%F %T')"
md5sum bin/*
./bin/test_candidates
python3 -I tests/run_tests.py --launcher "srun"

# memory check: ASan + LeakSanitizer build, launched with mpirun on this node only
# (ASan inside MPI_Init misfires under srun with Open MPI 4.1.5)
for nv in 1 2 3; do
    ASAN_OPTIONS=detect_leaks=1 mpirun --bind-to none --novm --host "$(hostname -s):16" -np 10 \
        bin/wsn_asan 3 3 -N $nv -B $nv -c 100 -t 3 -a 0.8 -d 0.2 -q -o results/tests/asan_N$nv \
        > results/tests/asan_N$nv.txt 2>&1
    echo "ASAN N$nv/B$nv rc=$? sanitizer_reports=$(grep -cE 'ERROR: (Address|Leak)Sanitizer|runtime error' results/tests/asan_N$nv.txt)"
done
